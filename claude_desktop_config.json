{
  "mcpServers": {
    "vibecraft-filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${HOME}/Projects"]
    },
    "vibecraft-brave-search": {
      "command": "npx",
      "args": ["-y", "@brave/brave-search-mcp-server"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "vibecraft-fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    }
  }
}
